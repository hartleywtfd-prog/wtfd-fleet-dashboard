{
  "name": "wtfd-fleet-dashboard",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-23",
  "keep_vars": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "services": [
    { "binding": "LIVE_GPS", "service": "wtfd-samsara-sync", "entrypoint": "LiveGps" }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "wtfd-fleet",
      "database_id": "ebd9c7d6-9089-4ead-bb53-f609e977f03f"
    }
  ]
}
